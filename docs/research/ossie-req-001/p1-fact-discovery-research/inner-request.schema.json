{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate fact users inner request; documentation draft only",
  "type": "object",
  "required": [
    "domain",
    "input_scope",
    "metrics",
    "cohort"
  ],
  "properties": {
    "domain": {
      "const": "common"
    },
    "input_scope": {
      "const": "entire_capture"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "cohort": {
      "$ref": "#/$defs/cohort"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cohort": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "all"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "predicate"
          ],
          "properties": {
            "operation": {
              "const": "predicate"
            },
            "predicate": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "operation",
            "children"
          ],
          "properties": {
            "operation": {
              "enum": [
                "intersection",
                "union",
                "difference"
              ]
            },
            "children": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/cohort"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
