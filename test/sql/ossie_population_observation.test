# name: test/sql/ossie_population_observation.test
# description: typed daily observation identity, separate users and nonnull amount denominators
# group: [sql]

require ossie

statement ok
CREATE TABLE observations(observation_id VARCHAR,user_id VARCHAR,ds DATE,product VARCHAR,amount_usd DECIMAL(18,2),classification_value INTEGER);

statement ok
INSERT INTO observations SELECT * FROM read_csv('docs/research/ossie-req-001/multi-period-research/observations.csv',header=true);

query TI
SELECT profile,records FROM ossie_bundle_load('test/fixtures/population-observation/bundle-10.json');
----
daily-observation-population-v1	8

query IIIRR
SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count','amount_value_count','amount_sum','mean_observation_amount'],[],[]);
----
6	3	5	31.00	6.20

query IIIRR
SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count','amount_value_count','amount_sum','mean_observation_amount'],[],['DailyObservation.product = ''X''']);
----
4	3	3	20.00	6.666667

query IIIRR
SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count','amount_value_count','amount_sum','mean_observation_amount'],[],['observations.user_id = ''C''']);
----
1	1	0	NULL	NULL

query IIIRR
SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count','amount_value_count','amount_sum','mean_observation_amount'],[],['DailyObservation.product = ''absent''']);
----
0	0	0	NULL	NULL

query TIIIRR rowsort
SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count','amount_value_count','amount_sum','mean_observation_amount'],['observations.ds'],[]);
----
2026-01-31	1	1	1	10.00	10.00
2026-02-01	5	3	4	21.00	5.25

query TTT rowsort
SELECT "observations.user_id","observations.ds","observations.product" FROM ossie_objects('QualifiedObservation',[]);
----
A	2026-02-01	X
A	2026-02-01	Y
B	2026-01-31	X
B	2026-02-01	X
B	2026-02-01	Y
C	2026-02-01	X

query TIIII rowsort
SELECT concept,objects_queryable,metrics_queryable,captured_observation_rows,captured_user_count FROM ossie_concepts_v2();
----
DailyObservation	true	true	8	4
QualifiedObservation	true	true	8	4
User	false	false	8	4

statement error
SELECT * FROM ossie_concepts();
----
compound identity requires ossie_concepts_v2

statement error
SELECT * FROM ossie_objects('User',[]);
----
referent-only

statement error
SELECT * FROM ossie_concept_query('User',['user_count'],[],[]);
----
referent-only

statement error
SELECT * FROM ossie_concept_query('DailyObservation',['user_count'],['observations.user_id'],[]);
----
only date and product

statement ok
PREPARE obs_pinned AS SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count'],[],[]);

statement ok
CALL ossie_bundle_load('test/fixtures/population-observation/bundle-20.json');

query IIIRR
SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count','amount_value_count','amount_sum','mean_observation_amount'],[],[]);
----
3	1	3	17.00	5.666667

query II
EXECUTE obs_pinned;
----
6	3

statement ok
INSERT INTO observations SELECT 'duplicate',user_id,ds,product,999,0 FROM observations WHERE observation_id='o1';

statement error
CALL ossie_bundle_load('test/fixtures/population-observation/bundle-10.json');
----
duplicate observation tuple

query II
SELECT * FROM ossie_concept_query('QualifiedObservation',['observation_count','user_count'],[],[]);
----
3	1

statement ok
DELETE FROM observations WHERE observation_id='duplicate';

statement ok
UPDATE observations SET ds=DATE 'infinity' WHERE observation_id='o1';

statement error
CALL ossie_bundle_load('test/fixtures/population-observation/bundle-10.json');
----
finite nonnull DATE

