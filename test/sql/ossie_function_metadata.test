# name: test/sql/ossie_function_metadata.test
# description: every registered function carries the metadata the registry publishes
# group: [sql]

# The community-extensions registry builds each extension's documentation page by snapshotting
# duckdb_functions() before and after loading the extension and diffing the two, then rendering the
# description, parameter names and examples it finds there. Anything left unset publishes as an
# empty column on a public page, and nothing in the build warns you.
#
# Note the overload subtlety: when a function has several overloads, duckdb_functions() decides
# which description belongs to which by scoring declared parameter_types against actual ones. A
# description with no types attached matches nothing, so all three ossie_query rows rendered empty
# until the types were declared. That is why arity is asserted here rather than just a count.

require ossie

# Every function has a description.
query I
SELECT count(*) FROM duckdb_functions()
WHERE starts_with(function_name, 'ossie_') AND (description IS NULL OR description = '');
----
0

# Every function has at least one runnable example.
query I
SELECT count(*) FROM duckdb_functions()
WHERE starts_with(function_name, 'ossie_') AND (examples IS NULL OR len(examples) = 0);
----
0

# Twenty-one registrations: seventeen names, with ossie_query contributing three overloads and
# ossie_date_trunc and ossie_dateadd two each (DATE and TIMESTAMP).
query II
SELECT count(*), count(DISTINCT function_name) FROM duckdb_functions()
WHERE starts_with(function_name, 'ossie_');
----
21	17

# Each date overload resolves to its own description.
query TTT
SELECT function_name, parameter_types[-1], CASE WHEN description IS NULL THEN 'MISSING' ELSE 'present' END
FROM duckdb_functions() WHERE function_name IN ('ossie_date_trunc', 'ossie_dateadd') ORDER BY 1, 2;
----
ossie_date_trunc	DATE	present
ossie_date_trunc	TIMESTAMP	present
ossie_dateadd	DATE	present
ossie_dateadd	TIMESTAMP	present

# Each ossie_query overload resolves to its own description rather than falling through to none.
query II
SELECT len(parameters), CASE WHEN description IS NULL THEN 'MISSING' ELSE 'present' END
FROM duckdb_functions() WHERE function_name = 'ossie_query' ORDER BY len(parameters);
----
1	present
2	present
3	present

# Categories are set, so the page groups these functions rather than scattering them.
query I
SELECT count(*) FROM duckdb_functions()
WHERE starts_with(function_name, 'ossie_') AND NOT list_contains(categories, 'ossie');
----
0

# The population surface is exactly the unified entries plus the native concept helpers.
query TI
SELECT function_name, len(parameters) FROM duckdb_functions()
WHERE starts_with(function_name, 'ossie_') AND NOT starts_with(function_name, 'ossie_query') AND function_name NOT IN ('ossie_load','ossie_metadata','ossie_relationships','ossie_datasets','ossie_fields','ossie_metrics','ossie_compile','ossie_date_trunc','ossie_dateadd') ORDER BY function_name;
----
ossie_bundle_load	1
ossie_concept_query	5
ossie_concepts	0
ossie_objects	3
ossie_population_compile	1
ossie_population_json	1
ossie_program	0

# Every parameter has its real name. DuckDB 2.0 takes names from the function's signature and no longer
# reads FunctionDescription.parameter_names, so without NameParameters these all read col0, col1, ...
query TT
SELECT function_name, parameters::VARCHAR FROM duckdb_functions()
WHERE starts_with(function_name, 'ossie_') ORDER BY function_name, len(parameters);
----
ossie_bundle_load	[path]
ossie_compile	[metrics, dimensions, filters]
ossie_concept_query	[concept, metrics, dimensions, filters, include_trace]
ossie_concepts	[]
ossie_datasets	[]
ossie_date_trunc	[part, date_expr]
ossie_date_trunc	[part, timestamp_expr]
ossie_dateadd	[part, amount, date_expr]
ossie_dateadd	[part, amount, timestamp_expr]
ossie_fields	[]
ossie_load	[path, rebind, validate_sources, allow_filter_functions, left_joins]
ossie_metadata	[]
ossie_metrics	[]
ossie_objects	[concept, filters, include_trace]
ossie_population_compile	[request_json]
ossie_population_json	[request_json]
ossie_program	[]
ossie_query	[metrics]
ossie_query	[metrics, dimensions]
ossie_query	[metrics, dimensions, filters]
ossie_relationships	[]
