statement ok
PREPARE previous_states AS SELECT regexp_extract(result_json,'"states":(.*),"comparison_columns"',1) FROM ossie_daily_states_json('QualifiedObservation','{"start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}');

statement ok
CALL ossie_bundle_load('test/fixtures/population-observation/bundle-20.json');

statement ok
DROP TABLE observations;

query T
EXECUTE previous_states;
----
[["A","2024-02-28","UNKNOWN"],["A","2024-02-29","TRUE"],["B","2024-02-28","FALSE"],["B","2024-02-29","FALSE"],["Outside","2024-02-28","UNKNOWN"],["Outside","2024-02-29","UNKNOWN"]]

query T
SELECT regexp_extract(result_json,'"states":(.*),"comparison_columns"',1) FROM ossie_daily_states_json('QualifiedObservation','{"start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}');
----
[["A","2024-02-28","UNKNOWN"],["A","2024-02-29","UNKNOWN"],["B","2024-02-28","FALSE"],["B","2024-02-29","FALSE"],["Outside","2024-02-28","UNKNOWN"],["Outside","2024-02-29","UNKNOWN"]]

query TT
SELECT regexp_extract(result_json,'"state_totals":(\{[^}]*\})',1),regexp_extract(result_json,'"changed_comparison_count":"([^"]+)"',1) FROM ossie_daily_states_json('QualifiedObservation','{"start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}');
----
{"unit":"User/day","TRUE":"0","FALSE":"2","UNKNOWN":"4"}	0
