# name: test/sql/ossie_grain.test
# description: grain analysis, multi-grain compilation and fan-out refusals
# group: [sql]

require ossie

statement ok
CALL ossie_load('test/fixtures/grain_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'});

# Two aggregates at different grains cannot share one GROUP BY: each grain is aggregated in its own
# subquery and the metric is evaluated over the results. With no dimensions there is one row a side.
query T
SELECT ossie_compile(['store_productivity'], [], []);
----
SELECT (store_sales.agg_0 / "nullif"(store.agg_0, 0)) AS store_productivity FROM (SELECT sum(store.s_number_employees) AS agg_0 FROM tpcds.main.store AS store) AS store CROSS JOIN (SELECT sum(store_sales.ss_ext_sales_price) AS agg_0 FROM tpcds.main.store_sales AS store_sales) AS store_sales

query T
SELECT ossie_compile(['customer_lifetime_value'], [], []);
----
SELECT (store_sales.agg_0 / customer.agg_0) AS customer_lifetime_value FROM (SELECT count(DISTINCT customer.c_customer_sk) AS agg_0 FROM tpcds.main.customer AS customer) AS customer CROSS JOIN (SELECT sum(store_sales.ss_ext_sales_price) AS agg_0 FROM tpcds.main.store_sales AS store_sales) AS store_sales

# Dimensions group every subquery and join them NULL-safely, keeping a group either side produced.
# An aggregate shared between metrics is computed once. Row filters go into every subquery, metric
# filters apply to the joined result.
query T
SELECT ossie_compile(['total_sales', 'store_productivity'], ['store.s_state'], ['store.s_state <> ''ZZ''', 'total_sales > 100']);
----
SELECT COALESCE(store.dim_0, store_sales.dim_0) AS "store.s_state", store_sales.agg_0 AS total_sales, (store_sales.agg_0 / "nullif"(store.agg_0, 0)) AS store_productivity FROM (SELECT store.s_state AS dim_0, sum(store.s_number_employees) AS agg_0 FROM tpcds.main.store AS store WHERE (store.s_state != 'ZZ') GROUP BY store.s_state) AS store FULL JOIN (SELECT store.s_state AS dim_0, sum(store_sales.ss_ext_sales_price) AS agg_0 FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.store AS store ON ((store_sales.ss_store_sk = store.s_store_sk)) WHERE (store.s_state != 'ZZ') GROUP BY store.s_state) AS store_sales ON ((store.dim_0 IS NOT DISTINCT FROM store_sales.dim_0)) WHERE (store_sales.agg_0 > 100)

# A filter or dimension must apply to every grain, so each grain has to reach its dataset without
# repeating rows. store cannot reach date_dim except through store_sales.
statement error
SELECT ossie_compile(['store_productivity'], [], ['date_dim.d_year = 2001']);
----
filter "date_dim.d_year = 2001" names dataset "date_dim", which "store" cannot join without repeating its rows

statement error
SELECT ossie_compile(['customer_lifetime_value'], ['item.i_brand'], []);
----
dimension "item.i_brand" names dataset "item", which "customer" cannot join without repeating its rows

# COUNT(*) has no grain of its own, and with two grains there is no single one to inherit.
statement error
SELECT ossie_compile(['total_sales', 'store_productivity', 'transaction_count'], [], []);
----
aggregate with no column reference, and the requested metrics aggregate at 2 different grains (store, store_sales)

# A second dataset referenced as a scalar is functionally determined by the grain, so it is an
# ordinary join rather than a fan-out. item must still be joined for the reference to bind.
query T
SELECT ossie_compile(['books_sales'], [], []);
----
SELECT sum(CASE  WHEN ((item.i_category = 'Books')) THEN (store_sales.ss_ext_sales_price) ELSE 0 END) AS books_sales FROM tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.item AS item ON ((store_sales.ss_item_sk = item.i_item_sk))

# COUNT(*) names no dataset, so alone there is no table to count.
statement error
SELECT ossie_compile(['transaction_count'], [], []);
----
has an aggregate with no column reference

# Alongside a metric that does have a grain, COUNT(*) inherits it.
query T
SELECT ossie_compile(['total_sales', 'transaction_count'], [], []);
----
SELECT sum(store_sales.ss_ext_sales_price) AS total_sales, count_star() AS transaction_count FROM tpcds.main.store_sales AS store_sales

# A dimension is not a grain: which dataset to count remains undetermined.
statement error
SELECT ossie_compile(['transaction_count'], ['item.i_brand'], []);
----
has an aggregate with no column reference

# Joining across a many-to-many edge repeats fact rows into every aggregate.
statement ok
CALL ossie_load('test/fixtures/many_to_many_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'});

statement error
SELECT ossie_compile(['total_sales'], ['store.s_state'], []);
----
repeats each "store_sales" row once per match
