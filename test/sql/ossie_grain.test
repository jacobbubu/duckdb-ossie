# name: test/sql/ossie_grain.test
# description: grain analysis, multi-grain compilation and fan-out refusals
# group: [sql]

require ossie

statement ok
CALL ossie_load('test/fixtures/grain_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'});

# Two aggregates at different grains cannot share one GROUP BY: each grain is aggregated in its own
# subquery and the metric is evaluated over the results. With no dimensions there is one row a side.
query T
SELECT ossie_compile(['store_productivity'], [], []);
----
SELECT (store_sales.agg_0 / "nullif"(store.agg_0, 0)) AS store_productivity FROM ((SELECT sum(store.s_number_employees) AS agg_0 FROM tpcds.main.store AS store) AS store CROSS JOIN (SELECT sum(store_sales.ss_ext_sales_price) AS agg_0 FROM tpcds.main.store_sales AS store_sales) AS store_sales)

query T
SELECT ossie_compile(['customer_lifetime_value'], [], []);
----
SELECT (store_sales.agg_0 / customer.agg_0) AS customer_lifetime_value FROM ((SELECT count(DISTINCT customer.c_customer_sk) AS agg_0 FROM tpcds.main.customer AS customer) AS customer CROSS JOIN (SELECT sum(store_sales.ss_ext_sales_price) AS agg_0 FROM tpcds.main.store_sales AS store_sales) AS store_sales)

# Dimensions group every subquery and join them NULL-safely, keeping a group either side produced.
# An aggregate shared between metrics is computed once. Row filters go into every subquery, metric
# filters apply to the joined result.
query T
SELECT ossie_compile(['total_sales', 'store_productivity'], ['store.s_state'], ['store.s_state <> ''ZZ'''], metric_filters => ['total_sales > 100']);
----
SELECT COALESCE(store.dim_0, store_sales.dim_0) AS s_state, store_sales.agg_0 AS total_sales, (store_sales.agg_0 / "nullif"(store.agg_0, 0)) AS store_productivity FROM ((SELECT store.s_state AS dim_0, sum(store.s_number_employees) AS agg_0 FROM tpcds.main.store AS store WHERE (store.s_state != 'ZZ') GROUP BY store.s_state) AS store FULL JOIN (SELECT store.s_state AS dim_0, sum(store_sales.ss_ext_sales_price) AS agg_0 FROM (tpcds.main.store_sales AS store_sales INNER JOIN tpcds.main.store AS store ON ((store_sales.ss_store_sk = store.s_store_sk))) WHERE (store.s_state != 'ZZ') GROUP BY store.s_state) AS store_sales ON ((store.dim_0 IS NOT DISTINCT FROM store_sales.dim_0))) WHERE (store_sales.agg_0 > 100)

# A filter or dimension must apply to every metric, so each metric has to reach its dataset from every
# dataset it aggregates without repeating rows. store cannot reach date_dim except through store_sales.
statement error
SELECT ossie_compile(['store_productivity'], [], ['date_dim.d_year = 2001']);
----
E_UNSUPPORTED_FILTER_PATH: filter "date_dim.d_year = 2001" reads "date_dim", which metric "store_productivity" cannot reach from "store", and a filter applies to every metric of the request: joining "store_sales" repeats each "store" row once per match

statement error
SELECT ossie_compile(['customer_lifetime_value'], ['item.i_brand'], []);
----
E_NO_PATH: dimension "item.i_brand" is a field of "item", which metric "customer_lifetime_value" cannot reach from "customer": joining "store_sales" repeats each "customer" row once per match

# An aggregate runs over the rows of the one dataset its arguments read. One that reads a second is refused,
# even where the first determines the second and joining them would repeat no row.
statement error
SELECT ossie_compile(['books_sales'], [], []);
----
ossie: E_AMBIGUOUS_MEASURE_GRAIN: metric "books_sales" has the aggregate SUM, whose arguments read 2 datasets (item, store_sales). An aggregate runs over the rows of the one dataset its arguments read; one over several is not supported yet

# COUNT(*) in a model-scoped metric reads no dataset, so nothing says whose rows it counts: not alone, not
# beside a metric that has a grain, not with a dimension.
statement error
SELECT ossie_compile(['transaction_count'], [], []);
----
ossie: E_AMBIGUOUS_MEASURE_GRAIN: metric "transaction_count" has the aggregate COUNT(*), whose arguments read no dataset, so nothing says whose rows it runs over. Declare it as a metric of the dataset whose rows it counts, and name that metric

statement error
SELECT ossie_compile(['total_sales', 'transaction_count'], [], []);
----
E_AMBIGUOUS_MEASURE_GRAIN: metric "transaction_count" has the aggregate COUNT(*), whose arguments read no dataset

statement error
SELECT ossie_compile(['transaction_count'], ['item.i_brand'], []);
----
E_AMBIGUOUS_MEASURE_GRAIN: metric "transaction_count" has the aggregate COUNT(*), whose arguments read no dataset

# Joining across a many-to-many edge repeats fact rows into every aggregate.
statement ok
CALL ossie_load('test/fixtures/many_to_many_model.json', rebind => MAP{'tpcds.public': 'tpcds.main'});

statement error
SELECT ossie_compile(['total_sales'], ['store.s_state'], []);
----
repeats each "store_sales" row once per match
