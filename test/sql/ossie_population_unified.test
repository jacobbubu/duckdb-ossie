# name: test/sql/ossie_population_unified.test
# description: ossie_population_json / ossie_population_compile / ossie_program route every request kind by profile
# group: [sql]

require ossie

# Each unified entry is registered with its arity.
query TI
SELECT function_name, len(parameters) FROM duckdb_functions()
WHERE function_name IN ('ossie_program','ossie_population_json','ossie_population_compile') ORDER BY function_name;
----
ossie_population_compile	1
ossie_population_json	1
ossie_program	0

statement error
SELECT * FROM ossie_program();
----
no bundle loaded

# ---- objects / metrics profile ----

statement ok
CREATE TABLE dws_gaap_di(ds DATE, product VARCHAR, region VARCHAR, user_type VARCHAR, user_id VARCHAR, gaap_val DECIMAL(18,2), ytd_gaap DECIMAL(18,2));

statement ok
COPY dws_gaap_di FROM 'test/fixtures/population-data/gaap-boundary.csv' (HEADER);

statement ok
CALL ossie_bundle_load('test/fixtures/population/bundle-10.json');

query TTT
SELECT regexp_extract(result_json,'"request_kind":"([^"]+)"',1), regexp_extract(result_json,'"rows":(\[.*\]),"row_count"',1), regexp_extract(result_json,'"row_count":(\d+)',1) FROM ossie_population_json('{"kind":"objects","concept":"ValidUser","filters":["User.product = ''A''"]}');
----
objects	[]	0

query TTT
SELECT regexp_extract(result_json,'"request_kind":"([^"]+)"',1), regexp_extract(result_json,'"rows":(\[.*\]),"row_count"',1), regexp_extract(result_json,'"row_count":(\d+)',1) FROM ossie_population_json('{"kind":"metrics","concept":"ValidUser","metrics":["gaap_sum","record_count"],"dimensions":["dws_gaap_di.product"],"filters":[]}');
----
metrics	[["X","180.00","6"],["Y","30.00","1"]]	2

# The unified compile returns the plan with the generated SQL and execution target appended.
query TTTI
SELECT regexp_extract(plan_json,'"request_kind":"([^"]+)"',1), regexp_extract(plan_json,'"executed":(true|false)',1), regexp_extract(plan_json,'"execution_target":"([^"]+)"\}$',1), contains(plan_json,',"sql":"SELECT \"system\".main.sum(dws_gaap_di.gaap_val) AS gaap_sum,')::INTEGER FROM ossie_population_compile('{"kind":"metrics","concept":"ValidUser","metrics":["gaap_sum"],"dimensions":[],"filters":[],"include_trace":true}');
----
metrics	false	frozen typed observation batch (AST dependency required)	1

query TTI
SELECT regexp_extract(program_json,'"schema_version":"([^"]+)"',1), regexp_extract(program_json,'"request_kinds":(\[[^\]]*\])',1), contains(program_json,'"program":null}')::INTEGER FROM ossie_program();
----
ossie-program-v1	["objects","metrics"]	1

query TTT
SELECT list_sort(regexp_extract_all(regexp_extract(program_json,'"concepts":(\[.*\]),"vocabulary":',1),'\{"concept":"([^"]+)"',1)), list_sort(regexp_extract_all(regexp_extract(program_json,'"metrics":(\[.*\]),"fields":',1),'\{"name":"([^"]+)"',1)), list_sort(regexp_extract_all(regexp_extract(program_json,'"fields":(\[.*\])\},"capabilities":',1),'"name":"([^"]+)","qualified_name"',1)) FROM ossie_program();
----
[User, ValidUser]	[gaap_sum, gaap_value_count, mean_gaap, record_count]	[ds, gaap_val, product, region, user_id, user_type, ytd_gaap]

query TTTT
SELECT regexp_extract(program_json,'"api_version":"([^"]+)"',1), regexp_extract(program_json,'"discovery_schema":"([^"]+)"',1), regexp_extract(program_json,'"plan_schema":"([^"]+)"',1), regexp_extract(program_json,'"capabilities":\{"scope":"([^"]+)"',1) FROM ossie_program();
----
2.2.0	ossie-population-discovery-v1	ossie-population-plan-v1	bound frozen bundle

# Envelope validation.

statement error
SELECT * FROM ossie_population_json(NULL);
----
request_json required

statement error
SELECT * FROM ossie_population_json('[]');
----
strict JSON object request required

statement error
SELECT * FROM ossie_population_json('{"concept":"ValidUser"}');
----
"object":"kind"

statement error
SELECT * FROM ossie_population_json('{"kind":"nope"}');
----
objects, metrics, daily_users, daily_states, relation_links, fact_users, fact_windows or history_links required

statement error
SELECT * FROM ossie_population_json('{"kind":"objects","filters":[]}');
----
"object":"concept"

statement error
SELECT * FROM ossie_population_json('{"kind":"objects","concept":"ValidUser","filters":[],"extra":1}');
----
undeclared JSON object key

statement error
SELECT * FROM ossie_population_compile('{"kind":"daily_users","concept":"ValidUser","start_date":"2026-01-01","end_date":"2026-01-02","products":{"mode":"all"}}');
----
UNSUPPORTED_CAPABILITY

# ---- daily observation profile ----

statement ok
CREATE TABLE observations(user_id VARCHAR,ds DATE,product VARCHAR,amount_usd DECIMAL(18,2),classification_value INTEGER);

statement ok
INSERT INTO observations VALUES ('A','2024-02-28','X',1,0),('A','2024-02-28','Y',1,NULL),('A','2024-02-29','X',1,10),('A','2024-02-29','Y',1,0),('A','2024-02-29','Z',1,NULL),('B','2024-02-28','X',1,0),('B','2024-02-29','X',1,0),('Outside','2023-01-01','X',1,10);

statement ok
CALL ossie_bundle_load('test/fixtures/population-observation/bundle-10.json');

query TT
SELECT regexp_extract(result_json,'"schema_version":"([^"]+)"',1), regexp_extract(result_json,'"states":(\[.*\]),"comparison_columns"',1) FROM ossie_population_json('{"kind":"daily_states","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}');
----
ossie-daily-states-result-v1	[["A","2024-02-28","UNKNOWN"],["A","2024-02-29","TRUE"],["B","2024-02-28","FALSE"],["B","2024-02-29","FALSE"],["Outside","2024-02-28","UNKNOWN"],["Outside","2024-02-29","UNKNOWN"]]

query TT
SELECT regexp_extract(plan_json,'"schema_version":"([^"]+)"',1), regexp_extract(plan_json,'"executed":(true|false)',1) FROM ossie_population_compile('{"kind":"daily_states","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}');
----
ossie-daily-states-plan-v1	false

query TT
SELECT regexp_extract(result_json,'"schema_version":"([^"]+)"',1), regexp_extract(result_json,'"members":(\[[^\]]*\])',1) FROM ossie_population_json('{"kind":"daily_users","concept":"QualifiedObservation","start_date":"2024-02-29","end_date":"2024-02-29","products":{"mode":"all"}}');
----
ossie-daily-user-set-result-v1	["A"]

query TT
SELECT regexp_extract(plan_json,'"schema_version":"([^"]+)"',1), regexp_extract(plan_json,'"executed":(true|false)',1) FROM ossie_population_compile('{"kind":"daily_users","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"}}');
----
ossie-daily-user-set-plan-v1	false

query TT
SELECT regexp_extract(result_json,'"request_kind":"([^"]+)"',1), regexp_extract(result_json,'"row_count":(\d+)',1) FROM ossie_population_json('{"kind":"objects","concept":"QualifiedObservation","filters":[]}');
----
objects	2

query TT
SELECT regexp_extract(program_json,'"request_kinds":(\[[^\]]*\])',1), regexp_extract(program_json,'"program":\{"schema_version":"([^"]+)"',1) FROM ossie_program();
----
["objects","metrics","daily_users","daily_states"]	ossie-daily-states-program-v1

# Daily request keys are still validated by the dedicated parser once the envelope is stripped.
statement error
SELECT * FROM ossie_population_json('{"kind":"daily_users","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"relationship":"x"}');
----
undeclared JSON object key

# ---- relation program profile ----

statement ok
DROP TABLE observations;

statement ok
CREATE TABLE observations(observation_id VARCHAR, user_id VARCHAR, ds DATE, product VARCHAR, amount_usd DECIMAL(18,2), classification_value INTEGER);

statement ok
INSERT INTO observations VALUES ('a','A','2026-01-01','X',1,10),('b','A','2026-02-01','Y',NULL,5),('c','B','2026-02-01','X',NULL,NULL);

statement ok
CALL ossie_bundle_load('test/fixtures/population-relation-program/bundle.json');

query TTT
SELECT regexp_extract(result_json,'"schema_version":"([^"]+)"',1), regexp_extract(result_json,'"relationship":"([^"]+)"',1), regexp_extract(result_json,'"links":(\[.*\]),"link_count"',1) FROM ossie_population_json('{"kind":"relation_links","relationship":"AUDITED_USER"}');
----
ossie-relation-result-v1	audited_user	[["A","2026-01-01","X","A"]]

query TT
SELECT regexp_extract(plan_json,'"schema_version":"([^"]+)"',1), regexp_extract(plan_json,'"executed":(true|false)',1) FROM ossie_population_compile('{"kind":"relation_links","relationship":"audited_user"}');
----
ossie-relation-plan-v1	false

query TIT
SELECT regexp_extract(program_json,'"request_kinds":(\[[^\]]*\])',1), contains(program_json,'"concepts":null,"vocabulary":null,"capabilities":null')::INTEGER, regexp_extract(program_json,'"program":\{"schema_version":"([^"]+)"',1) FROM ossie_program();
----
["relation_links"]	1	ossie-relation-program-v1

statement error
SELECT * FROM ossie_population_json('{"kind":"objects","concept":"X","filters":[]}');
----
UNSUPPORTED_CAPABILITY

# ---- multi-fact profile ----

statement ok
CREATE TABLE revenue(who VARCHAR, day DATE, value DECIMAL(18,2));

statement ok
INSERT INTO revenue VALUES ('A','2026-01-01',100),('A','2026-01-31',200),('A','2026-02-01',50),('A','2026-02-28',25),('B','2026-01-01',80),('B','2026-02-01',0),('C','2026-02-01',NULL),('D','2026-02-01',40);

statement ok
CREATE TABLE cost(who VARCHAR, day DATE, item VARCHAR, value DECIMAL(18,2));

statement ok
INSERT INTO cost VALUES ('A','2026-01-01','X',10),('A','2026-01-01','Y',20),('A','2026-01-31','X',40),('A','2026-02-01','X',5),('A','2026-02-01','Y',7),('A','2026-02-28','X',3),('B','2026-01-01','X',30),('B','2026-02-01','X',0),('C','2026-02-01','X',NULL),('E','2026-02-01','X',9);

statement ok
CALL ossie_bundle_load('test/fixtures/population-fact-program/bundle.json');

# Fact results echo the unified request verbatim, kind included.
query TIT
SELECT regexp_extract(result_json,'"schema_version":"([^"]+)"',1), contains(result_json,'"request":{"kind":"fact_users","domain":"common"')::INTEGER, regexp_extract(result_json,'"rows":(\[.*\])\}$',1) FROM ossie_population_json('{"kind":"fact_users","domain":"common","input_scope":"entire_capture","metrics":["balance"],"cohort":{"operation":"all"}}');
----
ossie-fact-users-result-v1	1	[["A","290.00"],["B","50.00"],["C",null]]

query TI
SELECT regexp_extract(plan_json,'"schema_version":"([^"]+)"',1), contains(plan_json,'"request":{"kind":"fact_users","domain":"common"')::INTEGER FROM ossie_population_compile('{"kind":"fact_users","domain":"common","input_scope":"entire_capture","metrics":["balance"],"cohort":{"operation":"all"}}');
----
ossie-fact-users-plan-v1	1

query TT
SELECT regexp_extract(result_json,'"schema_version":"([^"]+)"',1), regexp_extract(result_json,'"rows":(\[.*\])\}$',1) FROM ossie_population_json('{"kind":"fact_windows","input_scope":"entire_capture","windows":["previous","rolling"],"display":{"mode":"date_range","start_date":"2026-02-01","end_date":"2026-02-01"}}');
----
ossie-fact-windows-result-v1	[["A","2026-02-01","200.00","250.00"],["B","2026-02-01","80.00","80.00"],["C","2026-02-01",null,null],["D","2026-02-01",null,"40.00"]]

query TT
SELECT regexp_extract(plan_json,'"schema_version":"([^"]+)"',1), regexp_extract(plan_json,'"executed":(true|false)',1) FROM ossie_population_compile('{"kind":"fact_windows","input_scope":"entire_capture","windows":["previous","rolling"],"display":{"mode":"date_range","start_date":"2026-02-01","end_date":"2026-02-01"}}');
----
ossie-fact-windows-plan-v1	false

query TT
SELECT regexp_extract(program_json,'"request_kinds":(\[[^\]]*\])',1), regexp_extract(program_json,'"program":\{"schema_version":"([^"]+)"',1) FROM ossie_program();
----
["fact_users","fact_windows"]	ossie-fact-program-v1

# ---- historical observation profile ----

statement ok
DROP TABLE observations;

statement ok
