# ---- multi-fact profile ----

statement ok
CREATE TABLE revenue(who VARCHAR, day DATE, value DECIMAL(18,2));

statement ok
INSERT INTO revenue VALUES ('A','2026-01-01',100),('A','2026-01-31',200),('A','2026-02-01',50),('A','2026-02-28',25),('B','2026-01-01',80),('B','2026-02-01',0),('C','2026-02-01',NULL),('D','2026-02-01',40);

statement ok
CREATE TABLE cost(who VARCHAR, day DATE, item VARCHAR, value DECIMAL(18,2));

statement ok
INSERT INTO cost VALUES ('A','2026-01-01','X',10),('A','2026-01-01','Y',20),('A','2026-01-31','X',40),('A','2026-02-01','X',5),('A','2026-02-01','Y',7),('A','2026-02-28','X',3),('B','2026-01-01','X',30),('B','2026-02-01','X',0),('C','2026-02-01','X',NULL),('E','2026-02-01','X',9);

statement ok
CALL ossie_bundle_load('test/fixtures/population-fact-program/bundle.json');

# Fact results echo the request verbatim, so the unified route differs only in that echo.
query III
WITH l AS (SELECT result_json j FROM ossie_fact_users_json('{"domain":"common","input_scope":"entire_capture","metrics":["balance"],"cohort":{"operation":"all"}}')), u AS (SELECT result_json j FROM ossie_population_json('{"kind":"fact_users","domain":"common","input_scope":"entire_capture","metrics":["balance"],"cohort":{"operation":"all"}}'))
SELECT regexp_replace(l.j,'"request":\{.*?\},"selected','"request":_,"selected') = regexp_replace(u.j,'"request":\{.*?\},"selected','"request":_,"selected'), contains(l.j,'"request":{"domain":"common"'), contains(u.j,'"request":{"kind":"fact_users","domain":"common"') FROM l,u;
----
true	true	true

query I
WITH l AS (SELECT plan_json j FROM ossie_fact_users_compile('{"domain":"common","input_scope":"entire_capture","metrics":["balance"],"cohort":{"operation":"all"}}')), u AS (SELECT plan_json j FROM ossie_population_compile('{"kind":"fact_users","domain":"common","input_scope":"entire_capture","metrics":["balance"],"cohort":{"operation":"all"}}'))
SELECT regexp_replace(l.j,'"request":\{.*?\},"selected','"request":_,"selected') = regexp_replace(u.j,'"request":\{.*?\},"selected','"request":_,"selected') FROM l,u;
----
true

query I
WITH l AS (SELECT result_json j FROM ossie_fact_windows_json('{"input_scope":"entire_capture","windows":["previous","rolling"],"display":{"mode":"date_range","start_date":"2026-02-01","end_date":"2026-02-01"}}')), u AS (SELECT result_json j FROM ossie_population_json('{"kind":"fact_windows","input_scope":"entire_capture","windows":["previous","rolling"],"display":{"mode":"date_range","start_date":"2026-02-01","end_date":"2026-02-01"}}'))
SELECT regexp_replace(l.j,'"request":\{.*?\},"selected','"request":_,"selected') = regexp_replace(u.j,'"request":\{.*?\},"selected','"request":_,"selected') FROM l,u;
----
true

query I
WITH l AS (SELECT plan_json j FROM ossie_fact_windows_compile('{"input_scope":"entire_capture","windows":["previous","rolling"],"display":{"mode":"date_range","start_date":"2026-02-01","end_date":"2026-02-01"}}')), u AS (SELECT plan_json j FROM ossie_population_compile('{"kind":"fact_windows","input_scope":"entire_capture","windows":["previous","rolling"],"display":{"mode":"date_range","start_date":"2026-02-01","end_date":"2026-02-01"}}'))
SELECT regexp_replace(l.j,'"request":\{.*?\},"selected','"request":_,"selected') = regexp_replace(u.j,'"request":\{.*?\},"selected','"request":_,"selected') FROM l,u;
----
true

query TI
SELECT regexp_extract(program_json,'"request_kinds":(\[[^\]]*\])',1), ((SELECT program_json FROM ossie_fact_program()) = regexp_extract(program_json,'"program":(\{.*\})\}$',1))::INTEGER FROM ossie_program();
----
["fact_users","fact_windows"]	1

