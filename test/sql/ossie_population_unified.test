# name: test/sql/ossie_population_unified.test
# description: ossie_population_json / ossie_population_compile / ossie_program route by kind to the same binds as the dedicated functions
# group: [sql]

require ossie

# Each unified entry is registered with its arity.
query TI
SELECT function_name, len(parameters) FROM duckdb_functions()
WHERE function_name IN ('ossie_program','ossie_population_json','ossie_population_compile') ORDER BY function_name;
----
ossie_population_compile	1
ossie_population_json	1
ossie_program	0

statement error
SELECT * FROM ossie_program();
----
no bundle loaded

# ---- objects / metrics profile ----

statement ok
CREATE TABLE dws_gaap_di(ds DATE, product VARCHAR, region VARCHAR, user_type VARCHAR, user_id VARCHAR, gaap_val DECIMAL(18,2), ytd_gaap DECIMAL(18,2));

statement ok
COPY dws_gaap_di FROM 'test/fixtures/population-data/gaap-boundary.csv' (HEADER);

statement ok
CALL ossie_bundle_load('test/fixtures/population/bundle-10.json');

query I
SELECT (SELECT result_json FROM ossie_objects_json('ValidUser',['User.product = ''A'''])) = (SELECT result_json FROM ossie_population_json('{"kind":"objects","concept":"ValidUser","filters":["User.product = ''A''"]}'));
----
true

query I
SELECT (SELECT result_json FROM ossie_concept_query_json('ValidUser',['gaap_sum','record_count'],['dws_gaap_di.product'],[])) = (SELECT result_json FROM ossie_population_json('{"kind":"metrics","concept":"ValidUser","metrics":["gaap_sum","record_count"],"dimensions":["dws_gaap_di.product"],"filters":[]}'));
----
true

# The unified compile returns the dedicated plan_json with sql and execution_target appended.
query II
WITH l AS (SELECT * FROM ossie_concept_compile('ValidUser',['gaap_sum'],[],[],include_trace=>true)), u AS (SELECT plan_json FROM ossie_population_compile('{"kind":"metrics","concept":"ValidUser","metrics":["gaap_sum"],"dimensions":[],"filters":[],"include_trace":true}'))
SELECT substr(u.plan_json,1,length(l.plan_json)-1) = substr(l.plan_json,1,length(l.plan_json)-1), ends_with(u.plan_json, ',"sql":"' || replace(l.sql,'"','\"') || '","execution_target":"' || l.execution_target || '"}') FROM l, u;
----
true	true

query TTI
SELECT regexp_extract(program_json,'"schema_version":"([^"]+)"',1), regexp_extract(program_json,'"request_kinds":(\[[^\]]*\])',1), contains(program_json,'"program":null}')::INTEGER FROM ossie_program();
----
ossie-program-v1	["objects","metrics"]	1

query I
SELECT (SELECT list(concept ORDER BY concept) FROM ossie_concepts_v2()) = (SELECT list_sort(regexp_extract_all(regexp_extract(program_json,'"concepts":(\[.*\]),"vocabulary":',1),'\{"concept":"([^"]+)"',1)) FROM ossie_program());
----
true

query I
SELECT (SELECT list(name ORDER BY name) FROM ossie_population_metrics()) = (SELECT list_sort(regexp_extract_all(regexp_extract(program_json,'"metrics":(\[.*\]),"fields":',1),'\{"name":"([^"]+)"',1)) FROM ossie_program());
----
true

query I
SELECT (SELECT list(name ORDER BY name) FROM ossie_population_fields()) = (SELECT list_sort(regexp_extract_all(regexp_extract(program_json,'"fields":(\[.*\])\},"capabilities":',1),'"name":"([^"]+)","qualified_name"',1)) FROM ossie_program());
----
true

query I
SELECT (SELECT api_version || '|' || discovery_schema || '|' || plan_schema || '|' || ossie_spec_version || '|' || capabilities_json FROM ossie_population_capabilities()) = (SELECT regexp_extract(program_json,'"api_version":"([^"]+)"',1) || '|' || regexp_extract(program_json,'"discovery_schema":"([^"]+)"',1) || '|' || regexp_extract(program_json,'"plan_schema":"([^"]+)"',1) || '|' || regexp_extract(program_json,'"ossie_spec_version":"([^"]+)"',1) || '|' || regexp_extract(program_json,'"capabilities":(\{.*\}),"program":',1) FROM ossie_program());
----
true

# Envelope validation.

statement error
SELECT * FROM ossie_population_json(NULL);
----
request_json required

statement error
SELECT * FROM ossie_population_json('[]');
----
strict JSON object request required

statement error
SELECT * FROM ossie_population_json('{"concept":"ValidUser"}');
----
"object":"kind"

statement error
SELECT * FROM ossie_population_json('{"kind":"nope"}');
----
objects, metrics, daily_users, daily_states, relation_links, fact_users, fact_windows or history_links required

statement error
SELECT * FROM ossie_population_json('{"kind":"objects","filters":[]}');
----
"object":"concept"

statement error
SELECT * FROM ossie_population_json('{"kind":"objects","concept":"ValidUser","filters":[],"extra":1}');
----
undeclared JSON object key

statement error
SELECT * FROM ossie_population_compile('{"kind":"daily_users","concept":"ValidUser","start_date":"2026-01-01","end_date":"2026-01-02","products":{"mode":"all"}}');
----
UNSUPPORTED_CAPABILITY

# ---- daily observation profile ----

statement ok
CREATE TABLE observations(user_id VARCHAR,ds DATE,product VARCHAR,amount_usd DECIMAL(18,2),classification_value INTEGER);

statement ok
INSERT INTO observations VALUES ('A','2024-02-28','X',1,0),('A','2024-02-28','Y',1,NULL),('A','2024-02-29','X',1,10),('A','2024-02-29','Y',1,0),('A','2024-02-29','Z',1,NULL),('B','2024-02-28','X',1,0),('B','2024-02-29','X',1,0),('Outside','2023-01-01','X',1,10);

statement ok
CALL ossie_bundle_load('test/fixtures/population-observation/bundle-10.json');

query I
SELECT (SELECT result_json FROM ossie_daily_states_json('QualifiedObservation','{"start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}')) = (SELECT result_json FROM ossie_population_json('{"kind":"daily_states","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}'));
----
true

query I
SELECT (SELECT plan_json FROM ossie_daily_states_compile('QualifiedObservation','{"start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}')) = (SELECT plan_json FROM ossie_population_compile('{"kind":"daily_states","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"user_domain":"captured_users","transitions":"within_request_days"}'));
----
true

query I
SELECT (SELECT result_json FROM ossie_daily_users_json('QualifiedObservation','{"start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"}}')) = (SELECT result_json FROM ossie_population_json('{"kind":"daily_users","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"}}'));
----
true

query I
SELECT (SELECT plan_json FROM ossie_daily_users_compile('QualifiedObservation','{"start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"}}')) = (SELECT plan_json FROM ossie_population_compile('{"kind":"daily_users","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"}}'));
----
true

query I
SELECT (SELECT result_json FROM ossie_objects_json('QualifiedObservation',[])) = (SELECT result_json FROM ossie_population_json('{"kind":"objects","concept":"QualifiedObservation","filters":[]}'));
----
true

query TI
SELECT regexp_extract(program_json,'"request_kinds":(\[[^\]]*\])',1), ((SELECT program_json FROM ossie_daily_states_program()) = regexp_extract(program_json,'"program":(\{.*\})\}$',1))::INTEGER FROM ossie_program();
----
["objects","metrics","daily_users","daily_states"]	1

# Daily request keys are still validated by the dedicated parser once the envelope is stripped.
statement error
SELECT * FROM ossie_population_json('{"kind":"daily_users","concept":"QualifiedObservation","start_date":"2024-02-28","end_date":"2024-02-29","products":{"mode":"all"},"relationship":"x"}');
----
undeclared JSON object key

