# name: test/sql/ossie_population_result.test
# description: typed JSON result preserves native API and frozen binding
# group: [sql]

require ossie

statement error
SELECT * FROM ossie_population_json('{"kind":"objects","concept":"User","filters":[]}');
----
no bundle loaded

statement ok
CREATE TABLE dws_gaap_di(ds DATE, product VARCHAR, region VARCHAR, user_type VARCHAR, user_id VARCHAR, gaap_val DECIMAL(18,2), ytd_gaap DECIMAL(18,2));

statement ok
COPY dws_gaap_di FROM 'test/fixtures/population-data/gaap-boundary.csv' (HEADER);

statement ok
CALL ossie_bundle_load('test/fixtures/population/bundle-10.json');

query IIIII
SELECT contains(result_json,'"schema_version":"ossie-population-result-v1"')::INTEGER, contains(result_json,'"request_kind":"objects"')::INTEGER, contains(result_json,'"concept":"ValidUser"')::INTEGER, contains(result_json,'"bound_type":"DECIMAL(18,2)"')::INTEGER, contains(result_json,'"encoding":"decimal-text"')::INTEGER FROM ossie_population_json('{"kind":"objects","concept":"ValidUser","filters":[]}');
----
1	1	1	1	1

query IIII
SELECT contains(result_json,'"rows":[]')::INTEGER, contains(result_json,'"row_count":0')::INTEGER, contains(result_json,'"snapshot_id":')::INTEGER, contains(result_json,'"columns":[')::INTEGER FROM ossie_population_json('{"kind":"objects","concept":"ValidUser","filters":["User.product = ''absent''"]}');
----
1	1	1	1

query II
SELECT contains(result_json,'"bound_type":"DECIMAL(38,2)"')::INTEGER, contains(result_json,'"encoding":"integer-text"')::INTEGER FROM ossie_population_json('{"kind":"metrics","concept":"ValidUser","metrics":["gaap_sum","record_count"],"dimensions":[],"filters":[]}');
----
1	1

statement error
SELECT * FROM ossie_population_json('{"kind":"metrics","concept":"ValidUser","metrics":["gaap_sum","GAAP_SUM"],"dimensions":[],"filters":[]}');
----
have the same output name

statement error
SELECT * FROM ossie_population_json('{"kind":"metrics","concept":"ValidUser","metrics":["missing_metric"],"dimensions":[],"filters":[]}');
----
missing_metric

query TT
SELECT typeof(gaap_sum),typeof(record_count) FROM ossie_concept_query('ValidUser',['gaap_sum','record_count'],[],[]);
----
DECIMAL(38,2)	BIGINT

statement ok
CREATE TABLE old_typed_result AS SELECT * FROM ossie_population_json('{"kind":"objects","concept":"User","filters":[]}');

# DuckDB 2.0 rebinds any prepared statement whose plan scans a catalog table, so the
# frozen-binding check must not join old_typed_result: it inspects the bound snapshot sequence.
statement ok
PREPARE old_typed AS SELECT regexp_extract(result_json,'"snapshot_id":"[0-9a-f]+:([0-9]+)"',1) FROM ossie_population_json('{"kind":"objects","concept":"User","filters":[]}');

query I
SELECT (regexp_extract(result_json,'"snapshot_id":"[0-9a-f]+:([0-9]+)"',1)::INTEGER > 0)::INTEGER FROM ossie_population_json('{"kind":"objects","concept":"User","filters":[]}');
----
1

query T nosort old_typed_snapshot
EXECUTE old_typed;
----

statement ok
CALL ossie_bundle_load('test/fixtures/population/bundle-20.json');

query T nosort old_typed_snapshot
EXECUTE old_typed;
----

query I
SELECT (now.result_json<>previous.result_json)::INTEGER FROM ossie_population_json('{"kind":"objects","concept":"User","filters":[]}') now,old_typed_result previous;
----
1

statement error
CALL ossie_bundle_load('/missing/typed-bundle.json');
----
ossie_population_error_v1

query T nosort old_typed_snapshot
EXECUTE old_typed;
----
