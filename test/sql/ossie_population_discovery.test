# name: test/sql/ossie_population_discovery.test
# description: bound population vocabulary and project API version inside ossie_program()
# group: [sql]

require ossie

statement error
SELECT * FROM ossie_program();
----
no bundle loaded

statement ok
CREATE TABLE dws_gaap_di(ds DATE, product VARCHAR, region VARCHAR, user_type VARCHAR, user_id VARCHAR, gaap_val DECIMAL(18,2), ytd_gaap DECIMAL(18,2));

statement ok
COPY dws_gaap_di FROM 'test/fixtures/population-data/gaap-boundary.csv' (HEADER);

statement ok
CALL ossie_bundle_load('test/fixtures/population/bundle-10.json');

query T
SELECT regexp_extract(program_json,'"schema_version":"([^"]+)"',1) FROM ossie_program();
----
ossie-program-v1

query T
SELECT unnest(regexp_extract_all(regexp_extract(program_json,'"vocabulary":\{"metrics":(\[.*?\]),"fields":',1),'\{"name":"[^"]+","datatype":"[^"]*","bound_type":"[^"]+"',0)) FROM ossie_program() ORDER BY 1;
----
{"name":"gaap_sum","datatype":"","bound_type":"DECIMAL(38,2)"
{"name":"gaap_value_count","datatype":"","bound_type":"BIGINT"
{"name":"mean_gaap","datatype":"Float","bound_type":"DOUBLE"
{"name":"record_count","datatype":"","bound_type":"BIGINT"

query I
SELECT len(regexp_extract_all(regexp_extract(program_json,'"vocabulary":\{"metrics":(\[.*?\]),"fields":',1),'"load_preflight_validated":true,"execution_verified":false\}',0)) FROM ossie_program();
----
4

query T
SELECT regexp_extract(program_json,'(\{"dataset":"dws_gaap_di","name":"ds","qualified_name":"dws_gaap_di.ds","object_column":"dws_gaap_di.ds","datatype":"Date","bound_type":"DATE".*?"is_time":true,"is_time_explicit":false)',1) FROM ossie_program();
----
{"dataset":"dws_gaap_di","name":"ds","qualified_name":"dws_gaap_di.ds","object_column":"dws_gaap_di.ds","datatype":"Date","bound_type":"DATE","label":"","description":"","expression":"ds","selected_dialect":"OSSIE_SQL_2026","available_dialects":["OSSIE_SQL_2026"],"synonyms":[],"examples":[],"instructions":"","ai_context":null,"nonportable_extensions":null,"is_time":true,"is_time_explicit":false

query TTTT
SELECT regexp_extract(program_json,'"api_version":"([^"]+)"',1), regexp_extract(program_json,'"discovery_schema":"([^"]+)"',1), regexp_extract(program_json,'"plan_schema":"([^"]+)"',1), regexp_extract(program_json,'"ossie_spec_version":"([^"]+)"',1) FROM ossie_program();
----
2.2.0	ossie-population-discovery-v1	ossie-population-plan-v1	0.3.0.dev0

# Bundle identity is stated once in the header rather than repeated per embedded row.
query I
SELECT len(regexp_extract_all(program_json,'"snapshot_id":"([^"]+)"',1)) FROM ossie_program();
----
1

statement ok
CREATE TABLE old_manifest AS SELECT regexp_extract(program_json,'"manifest_sha256":"([^"]+)"',1) AS manifest_sha256 FROM ossie_program();

# DuckDB 2.0 rebinds any prepared statement whose plan scans a catalog table, so the
# frozen-binding check must not join old_manifest: it inspects the bound snapshot sequence.
statement ok
PREPARE old_discovery AS SELECT regexp_extract(program_json,'"snapshot_id":"[0-9a-f]+:([0-9]+)"',1) FROM ossie_program();

query I
SELECT (regexp_extract(program_json,'"snapshot_id":"[0-9a-f]+:([0-9]+)"',1)::INTEGER > 0)::INTEGER FROM ossie_program();
----
1

query T nosort old_discovery_snapshot
EXECUTE old_discovery;
----

statement ok
CALL ossie_bundle_load('test/fixtures/population/bundle-20.json');

query I
SELECT (old_manifest.manifest_sha256 <> regexp_extract(program_json,'"manifest_sha256":"([^"]+)"',1))::INTEGER FROM old_manifest,ossie_program();
----
1

query T nosort old_discovery_snapshot
EXECUTE old_discovery;
----

# Legacy manifests retain their original active-contract version and no opt-in payload.
query I
SELECT (strpos(program_json, '"concept_constraints"')=0)::INTEGER FROM ossie_program();
----
1
