# name: test/sql/ossie_population.test
# description: frozen single-table ontology population, NULL boundaries and identity preflight
# group: [sql]

require ossie

statement ok
CREATE TABLE dws_gaap_di(ds DATE, product VARCHAR, region VARCHAR, user_type VARCHAR, user_id VARCHAR, gaap_val DECIMAL(18,2), ytd_gaap DECIMAL(18,2));

statement ok
INSERT INTO dws_gaap_di SELECT * FROM read_csv('docs/research/ossie-req-001/gaap-boundary.csv', header=true);

statement ok
