# A duplicate in a row outside the selected product/date still invalidates the whole batch.
statement ok
INSERT INTO dws_gaap_di VALUES (DATE '2026-05-01','Y','North','student','new',30,0);

statement error
CALL ossie_bundle_load('test/fixtures/population/bundle-20.json');
----
entire batch violates

query I
SELECT count(*) FROM ossie_objects('User', []);
----
12

statement ok
DELETE FROM dws_gaap_di WHERE ds=DATE '2026-05-01';

statement ok
INSERT INTO dws_gaap_di VALUES (DATE '2026-05-01','Y','North','student',NULL,30,0);

statement error
CALL ossie_bundle_load('test/fixtures/population/bundle-10.json');
----
entire batch violates

statement ok
