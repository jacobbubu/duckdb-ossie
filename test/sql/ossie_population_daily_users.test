# name: test/sql/ossie_population_daily_users.test
# description: complete every-calendar-day User set, strict request and resource refusal
# group: [sql]

require ossie

statement ok
CREATE TABLE observations(observation_id VARCHAR,user_id VARCHAR,ds DATE,product VARCHAR,amount_usd DECIMAL(18,2),classification_value INTEGER);

statement ok
INSERT INTO observations SELECT * FROM read_csv('docs/research/ossie-req-001/multi-period-research/every-day/observations.csv',header=true);

statement ok
CALL ossie_bundle_load('test/fixtures/population-observation/bundle-10.json');

query TTT
SELECT regexp_extract(result_json,'"schema_version":"([^"]+)"',1),regexp_extract(result_json,'"member_count":"([^"]+)"',1),regexp_extract(result_json,'"members":(\[[^]]*\])',1) FROM ossie_daily_users_json('QualifiedObservation','{"start_date":"2026-01-31","end_date":"2026-02-01","products":{"mode":"all"}}');
----
ossie-daily-user-set-result-v1	5	["B","E","F","H","K"]

query T
SELECT regexp_extract(result_json,'"members":(\[[^]]*\])',1) FROM ossie_daily_users_json('QualifiedObservation','{"start_date":"2026-01-31","end_date":"2026-02-01","products":{"mode":"subset","values":["X"]}}');
----
