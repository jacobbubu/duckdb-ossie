# name: test/sql/ossie_differential.test
# description: generated SQL must agree with hand-written SQL over real TPC-DS data
# group: [sql]

require ossie

require tpcds

statement ok
CALL dsdgen(sf = 0.01);

statement ok
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'memory.main'});

# An ungrouped metric equals the plain aggregate.
query I
SELECT (SELECT total_sales FROM ossie_query(['total_sales']))
     - (SELECT sum(ss_ext_sales_price) FROM store_sales);
----
0.00

# Grouped by a dimension, every row must match the hand-written join. Symmetric EXCEPT so that
# extra rows on either side are caught.
query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query(['total_sales'], ['item.i_brand'])
   EXCEPT
   SELECT i_brand, sum(ss_ext_sales_price) FROM store_sales JOIN item ON ss_item_sk = i_item_sk GROUP BY i_brand)
  UNION ALL
  (SELECT i_brand, sum(ss_ext_sales_price) FROM store_sales JOIN item ON ss_item_sk = i_item_sk GROUP BY i_brand
   EXCEPT
   SELECT * FROM ossie_query(['total_sales'], ['item.i_brand']))
);
----
0

# The same with a filter, which pulls date_dim into the join.
query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query(['total_sales'], ['item.i_brand'], ['date_dim.d_year = 2001'])
   EXCEPT
   SELECT i_brand, sum(ss_ext_sales_price) FROM store_sales
     JOIN item ON ss_item_sk = i_item_sk
     JOIN date_dim ON ss_sold_date_sk = d_date_sk
   WHERE d_year = 2001 GROUP BY i_brand)
  UNION ALL
  (SELECT i_brand, sum(ss_ext_sales_price) FROM store_sales
     JOIN item ON ss_item_sk = i_item_sk
     JOIN date_dim ON ss_sold_date_sk = d_date_sk
   WHERE d_year = 2001 GROUP BY i_brand
   EXCEPT
   SELECT * FROM ossie_query(['total_sales'], ['item.i_brand'], ['date_dim.d_year = 2001']))
);
----
0

# Without a metric the dimensions alone say which rows are read: the distinct brands of item, including
# brands nothing was sold under, and the distinct (brand, year) pairs of the sales that have both.
query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query([], ['item.i_brand']) EXCEPT SELECT DISTINCT i_brand FROM item)
  UNION ALL
  (SELECT DISTINCT i_brand FROM item EXCEPT SELECT * FROM ossie_query([], ['item.i_brand']))
);
----
0

query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query([], ['store_sales.ss_item_sk', 'item.i_brand'], ['date_dim.d_year = 2001'])
   EXCEPT
   SELECT DISTINCT ss_item_sk, i_brand FROM store_sales
     JOIN item ON ss_item_sk = i_item_sk
     JOIN date_dim ON ss_sold_date_sk = d_date_sk
   WHERE d_year = 2001)
  UNION ALL
  (SELECT DISTINCT ss_item_sk, i_brand FROM store_sales
     JOIN item ON ss_item_sk = i_item_sk
     JOIN date_dim ON ss_sold_date_sk = d_date_sk
   WHERE d_year = 2001
   EXCEPT
   SELECT * FROM ossie_query([], ['store_sales.ss_item_sk', 'item.i_brand'], ['date_dim.d_year = 2001']))
);
----
0

# A condition on a metric is applied after aggregation, as HAVING is. It keeps some brands and drops
# others, so the comparison below is not between two empty or two complete results.
query I
SELECT count(*) BETWEEN 1 AND 110
FROM ossie_query(['total_sales'], ['item.i_brand'], metric_filters => ['total_sales > 300000']);
----
true

query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query(['total_sales'], ['item.i_brand'], ['date_dim.d_year = 2001'],
                             metric_filters => ['total_sales > 50000', 'total_profit < 0'])
   EXCEPT
   SELECT i_brand, sum(ss_ext_sales_price) FROM store_sales
     JOIN item ON ss_item_sk = i_item_sk
     JOIN date_dim ON ss_sold_date_sk = d_date_sk
   WHERE d_year = 2001 GROUP BY i_brand
   HAVING sum(ss_ext_sales_price) > 50000 AND sum(ss_net_profit) < 0)
  UNION ALL
  (SELECT i_brand, sum(ss_ext_sales_price) FROM store_sales
     JOIN item ON ss_item_sk = i_item_sk
     JOIN date_dim ON ss_sold_date_sk = d_date_sk
   WHERE d_year = 2001 GROUP BY i_brand
   HAVING sum(ss_ext_sales_price) > 50000 AND sum(ss_net_profit) < 0
   EXCEPT
   SELECT * FROM ossie_query(['total_sales'], ['item.i_brand'], ['date_dim.d_year = 2001'],
                             metric_filters => ['total_sales > 50000', 'total_profit < 0']))
);
----
0

# With no metric requested, the metric filter still decides which groups are returned.
query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query([], ['item.i_brand'], metric_filters => ['total_sales > 300000'])
   EXCEPT
   SELECT i_brand FROM store_sales JOIN item ON ss_item_sk = i_item_sk
   GROUP BY i_brand HAVING sum(ss_ext_sales_price) > 300000)
  UNION ALL
  (SELECT i_brand FROM store_sales JOIN item ON ss_item_sk = i_item_sk
   GROUP BY i_brand HAVING sum(ss_ext_sales_price) > 300000
   EXCEPT
   SELECT * FROM ossie_query([], ['item.i_brand'], metric_filters => ['total_sales > 300000']))
);
----
0

# Joins are INNER, so grouping by a dimension whose foreign key is nullable drops those rows.
# The shortfall is exactly the sales with no store, which pins the documented behaviour.
query I
SELECT (SELECT total_sales FROM ossie_query(['total_sales']))
     - (SELECT sum(total_sales) FROM ossie_query(['total_sales'], ['store.s_state']))
     - (SELECT sum(ss_ext_sales_price) FROM store_sales WHERE ss_store_sk IS NULL);
----
0.00

# With left_joins those rows survive as a NULL group, and the grouped total equals the ungrouped one.
statement ok
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'memory.main'}, left_joins => true);

query I
SELECT (SELECT total_sales FROM ossie_query(['total_sales']))
     - (SELECT sum(total_sales) FROM ossie_query(['total_sales'], ['store.s_state']));
----
0.00

query I
SELECT (SELECT total_sales FROM ossie_query(['total_sales'], ['store.s_state']) WHERE s_state IS NULL)
     - (SELECT sum(ss_ext_sales_price) FROM store_sales WHERE ss_store_sk IS NULL);
----
0.00

# Guard: the NULL group exists and carries sales, so the checks above compared something.
query I
SELECT count(*) FROM store_sales WHERE ss_store_sk IS NULL AND ss_ext_sales_price IS NOT NULL;
----
<REGEX>:[1-9][0-9]*

statement ok
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'memory.main'});

statement ok
CALL ossie_load('test/fixtures/grain_model.json', rebind => MAP{'tpcds.public': 'memory.main'});

# A metric at two grains divides the whole of one dataset by the whole of the other: the
# denominator counts every store once, not once per sale.
query I
SELECT (SELECT store_productivity FROM ossie_query(['store_productivity']))
     - (SELECT (SELECT sum(ss_ext_sales_price) FROM store_sales)
              / NULLIF((SELECT sum(s_number_employees) FROM store), 0));
----
0.0

query I
SELECT (SELECT customer_lifetime_value FROM ossie_query(['customer_lifetime_value']))
     - (SELECT (SELECT sum(ss_ext_sales_price) FROM store_sales)
              / (SELECT count(DISTINCT c_customer_sk) FROM customer));
----
0.0

# Grouped, each side is aggregated at its own grain and the groups are matched by value.
statement ok
CREATE TABLE hand_productivity AS
SELECT COALESCE(s.s_state, f.s_state) AS s_state, f.total_sales, f.total_sales / NULLIF(s.employees, 0) AS store_productivity
FROM (SELECT s_state, sum(s_number_employees) AS employees FROM store GROUP BY s_state) s
FULL JOIN (SELECT s_state, sum(ss_ext_sales_price) AS total_sales
           FROM store_sales JOIN store ON ss_store_sk = s_store_sk GROUP BY s_state) f
  ON s.s_state IS NOT DISTINCT FROM f.s_state;

query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query(['total_sales', 'store_productivity'], ['store.s_state']) EXCEPT SELECT * FROM hand_productivity)
  UNION ALL
  (SELECT * FROM hand_productivity EXCEPT SELECT * FROM ossie_query(['total_sales', 'store_productivity'], ['store.s_state']))
);
----
0

query I
SELECT count(*) > 0 FROM hand_productivity WHERE store_productivity IS NOT NULL;
----
true

# --- OSSIE_SQL_2026 ----------------------------------------------------------------------------------
# The reference model with every expression relabelled OSSIE_SQL_2026 must give the same numbers as the
# ANSI_SQL original: the lowering may only change spellings, never results. Each answer is taken from
# the ANSI model first, then compared row for row against the OSSIE_SQL_2026 model.

statement ok
CALL ossie_load('test/fixtures/tpcds_semantic_model.json', rebind => MAP{'tpcds.public': 'memory.main'});

statement ok
CREATE TABLE ansi_brand AS SELECT * FROM ossie_query(['total_sales', 'total_profit'], ['item.i_brand']);

statement ok
CREATE TABLE ansi_state_2001 AS SELECT * FROM ossie_query(['total_sales'], ['store.s_state'], ['date_dim.d_year = 2001']);

statement ok
CREATE TABLE ansi_customer AS SELECT * FROM ossie_query(['total_sales'], ['customer.customer_full_name']);

# The OSSIE_SQL_2026 model is built here from the reference model rather than kept as a second 900-line
# file, so the two can never drift: only the dialect label changes.
statement ok
COPY (SELECT replace(content, '"dialect": "ANSI_SQL"', '"dialect": "OSSIE_SQL_2026"')
      FROM read_text('test/fixtures/tpcds_semantic_model.json'))
TO '__TEST_DIR__/tpcds_semantic_model_ossie_sql_2026.json' (FORMAT csv, HEADER false, QUOTE '');

# Every expression was relabelled, and none was missed
query II
SELECT strpos(content, '"ANSI_SQL"'), (length(content) - length(replace(content, '"OSSIE_SQL_2026"', ''))) // 16
FROM read_text('__TEST_DIR__/tpcds_semantic_model_ossie_sql_2026.json');
----
0	36

statement ok
CALL ossie_load('__TEST_DIR__/tpcds_semantic_model_ossie_sql_2026.json', rebind => MAP{'tpcds.public': 'memory.main'});

query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query(['total_sales', 'total_profit'], ['item.i_brand']) EXCEPT SELECT * FROM ansi_brand)
  UNION ALL
  (SELECT * FROM ansi_brand EXCEPT SELECT * FROM ossie_query(['total_sales', 'total_profit'], ['item.i_brand']))
);
----
0

query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query(['total_sales'], ['store.s_state'], ['date_dim.d_year = 2001']) EXCEPT SELECT * FROM ansi_state_2001)
  UNION ALL
  (SELECT * FROM ansi_state_2001 EXCEPT SELECT * FROM ossie_query(['total_sales'], ['store.s_state'], ['date_dim.d_year = 2001']))
);
----
0

# A field defined by an expression (first || ' ' || last), not just a column
query I
SELECT count(*) FROM (
  (SELECT * FROM ossie_query(['total_sales'], ['customer.customer_full_name']) EXCEPT SELECT * FROM ansi_customer)
  UNION ALL
  (SELECT * FROM ansi_customer EXCEPT SELECT * FROM ossie_query(['total_sales'], ['customer.customer_full_name']))
);
----
0

# Guard against a vacuous pass: the comparisons above must have had rows to compare
query III
SELECT count(*) > 100, count(*) FILTER (WHERE total_sales IS NOT NULL) > 100, (SELECT count(*) FROM ansi_customer) > 100 FROM ansi_brand;
----
true	true	true
