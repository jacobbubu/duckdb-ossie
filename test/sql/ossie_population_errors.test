# name: test/sql/ossie_population_errors.test
# description: structured population errors on the unified request entry
# group: [sql]

require ossie

statement error
SELECT * FROM ossie_program();
----
"schema_version":"ossie-population-error-v1"

statement error
SELECT * FROM ossie_population_json(NULL);
----
"stage":"arguments"

statement error
SELECT * FROM ossie_population_json('{');
----
strict JSON object request required

statement error
SELECT * FROM ossie_population_json('[]');
----
"object":"ossie_population_json"

statement error
SELECT * FROM ossie_population_json('{"concept":"ValidUser"}');
----
"kind"

statement error
SELECT * FROM ossie_population_json('{"kind":"windows","concept":"ValidUser"}');
----
"missing_capability":null

statement error
SELECT * FROM ossie_population_compile('{"kind":"objects","concept":"ValidUser","filters":[1]}');
----
"object":"filters[0]"
