          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "shipment_id"
              }
            ]
          }
        },
        {
          "name": "batch_id",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "batch_id"
              }
            ]
          }
        },
        {
          "name": "ready",
          "datatype": "Boolean",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "ready"
              }
            ]
          }
        },
        {
          "name": "expires",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "expires"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "batches",
      "source": "memory.main.req_batches",
      "primary_key": [
        "batch_id"
      ],
      "fields": [
        {
          "name": "batch_id",
          "datatype": "Integer",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "batch_id"
              }
            ]
          }
        },
        {
          "name": "expires",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "ANSI_SQL",
                "expression": "expires"
              }
            ]
          }
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "shipment_batch",
      "from": "shipments",
      "to": "batches",
      "from_columns": [
        "batch_id"
      ],
      "to_columns": [
        "batch_id"
      ]
    }
  ],
  "metrics": [
    {
      "name": "shipment_count",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "ANSI_SQL",
