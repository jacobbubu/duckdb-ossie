{
  "version": "0.2.0.dev0",
  "name": "two_fact_demo",
  "description": "Synthetic additive USD observations; independent fact grains, not GAAP or cumulative YTD.",
  "datasets": [
    {
      "name": "revenue",
      "source": "memory.main.revenue",
      "primary_key": [
        "who",
        "day"
      ],
      "fields": [
        {
          "name": "user_id",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "who"
              }
            ]
          }
        },
        {
          "name": "ds",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "day"
              }
            ]
          }
        },
        {
          "name": "amount",
          "datatype": "Decimal",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "value"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "cost",
      "source": "memory.main.cost",
      "primary_key": [
        "who",
        "day",
        "item"
      ],
      "fields": [
        {
          "name": "user_id",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "who"
              }
            ]
          }
        },
        {
          "name": "ds",
          "datatype": "Date",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "day"
              }
            ]
          }
        },
        {
          "name": "product",
          "datatype": "String",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "item"
              }
            ]
          }
        },
        {
          "name": "amount",
          "datatype": "Decimal",
          "expression": {
            "dialects": [
              {
                "dialect": "OSSIE_SQL_2026",
                "expression": "value"
              }
            ]
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "balance",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "income-expense"
          }
        ]
      }
    },
    {
      "name": "income",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(revenue.amount)"
          }
        ]
      }
    },
    {
      "name": "expense",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(cost.amount)"
          }
        ]
      }
    },
    {
      "name": "revenue_rows",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(revenue.user_id)"
          }
        ]
      }
    },
    {
      "name": "revenue_values",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(revenue.amount)"
          }
        ]
      }
    },
    {
      "name": "cost_rows",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(cost.user_id)"
          }
        ]
      }
    },
    {
      "name": "cost_values",
      "datatype": "Integer",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "COUNT(cost.amount)"
          }
        ]
      }
    },
    {
      "name": "previous",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "LAG(revenue.amount,1,NULL) OVER(PARTITION BY revenue.user_id ORDER BY revenue.ds)"
          }
        ]
      }
    },
    {
      "name": "rolling",
      "datatype": "Decimal",
      "expression": {
        "dialects": [
          {
            "dialect": "OSSIE_SQL_2026",
            "expression": "SUM(revenue.amount) OVER(PARTITION BY revenue.user_id ORDER BY revenue.ds ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)"
          }
        ]
      }
    }
  ]
}
