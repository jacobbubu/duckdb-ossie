          "verbalizes": [
            "{User} has date {Date}"
          ]
        },
        {
          "name": "product",
          "roles": [
            {
              "concept": "String"
            }
          ],
          "multiplicity": "ManyToOne",
          "verbalizes": [
            "{User} has product {String}"
          ]
        },
        {
          "name": "region",
          "roles": [
            {
              "concept": "String"
            }
          ],
          "multiplicity": "ManyToOne",
          "verbalizes": [
            "{User} has region {String}"
          ]
        },
        {
          "name": "user_type",
          "roles": [
            {
              "concept": "String"
            }
          ],
